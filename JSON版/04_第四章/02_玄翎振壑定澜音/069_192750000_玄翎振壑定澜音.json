  "chapters": [
    {
      "number": 4,
      "title": "第四章",
      "sections": [
        {
          "number": 2,
          "title": "玄翎振壑定澜音",
          "act": "第二幕",
          "notes": [],
          "tasks": [
            {
              "sequence": 69,
              "quest_id": 192750000,
              "title": "玄翎振壑定澜音",
              "reading_status": "ordered_draft",
              "notes": [],
              "events": [
                {
                  "sequence": 1,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "漂泊者，秧秧，你们来了。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_2"
                },
                {
                  "sequence": 2,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "秋鸿卫长，大家的情况怎么样了？",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_470_3"
                },
                {
                  "sequence": 3,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "大体上是稳定下来了，不过，救治伤员、重整军队、安置民众……百废待兴，也不能操之过急。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_4"
                },
                {
                  "sequence": 4,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "椋羽虽然已经可堪大任，但她在守城时拼死顽战，一度陷入超频，现在还在华胥研究院接受治疗。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_5"
                },
                {
                  "sequence": 5,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "如今可用之人太少……也是一个烦恼。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_6"
                },
                {
                  "sequence": 6,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "那位清宵司骑呢？",
                  "text_id": "Main_HuangLong_XLZHDLY_470_25",
                  "choice_key": "剧情_3_5_后日谈梦州_2_1:5",
                  "selected_index": 0
                },
                {
                  "sequence": 7,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "清宵司骑……已经赶往咎庭清理残象了。但光靠她一个人，也没办法应付所有事态。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_27"
                },
                {
                  "sequence": 8,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "……",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_470_7"
                },
                {
                  "sequence": 9,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "即便如此，我们好歹是打了场胜仗，应当高兴一些。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_8"
                },
                {
                  "sequence": 10,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "多亏了你们。各位的功绩，秋鸿日后定向梦州边庭上报，玄方地界和梦州会永远铭记你们的贡献。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_9"
                },
                {
                  "sequence": 11,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "但我们还没抓到木禺。",
                  "text_id": "Main_HuangLong_XLZHDLY_470_10",
                  "choice_key": "剧情_3_5_后日谈梦州_2_1:9",
                  "selected_index": 0
                },
                {
                  "sequence": 12,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "嗯，确实。军策府也会分出人手去调查他的踪迹，不过，此人在玄方地界潜伏多年，并且精通傀儡之术，想要找到他的蛛丝马迹，恐怕会很困难。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_12"
                },
                {
                  "sequence": 13,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "那些被他影响的机傀怎么样了？",
                  "text_id": "Main_HuangLong_XLZHDLY_470_13",
                  "choice_key": "剧情_3_5_后日谈梦州_2_1:10",
                  "selected_index": 0
                },
                {
                  "sequence": 14,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "都被收容在天工隔离观察，它们虽然现在已经不具备对人的攻击性，但仍处于一个不正常的状态。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_14"
                },
                {
                  "sequence": 15,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "工匠们不知道怎么检修，也没办法让它们停止行动。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_15"
                },
                {
                  "sequence": 16,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "毕竟我新获得的能力……似乎只是让那些被植入的情感恢复到了歪曲前的状态，并没有把残响从核心中剥离出来。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_470_16"
                },
                {
                  "sequence": 17,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "那些恨意与愤怒本身仍然干扰着机傀的系统，恐怕只有制造它们的岁主才能彻底解决这个问题。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_470_17"
                },
                {
                  "sequence": 18,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "只能一步一步来了。",
                  "text_id": "Main_HuangLong_XLZHDLY_470_18",
                  "choice_key": "剧情_3_5_后日谈梦州_2_1:14",
                  "selected_index": 0
                },
                {
                  "sequence": 19,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "说起来，现在玄方城和外界的通讯已经恢复，终端的功能应该也都能正常使用了。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_20"
                },
                {
                  "sequence": 20,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "得向白芷他们报个平安。",
                  "text_id": "Main_HuangLong_XLZHDLY_470_21",
                  "choice_key": "剧情_3_5_后日谈梦州_2_1:15",
                  "selected_index": 0
                },
                {
                  "sequence": 21,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "嗯，我也想知道炽霞恢复得怎么样了。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_470_23"
                },
                {
                  "sequence": 22,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "既然如此，我暂时就不打扰了。有紧急事项，我再联络二位。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_470_24"
                },
                {
                  "sequence": 23,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "漂泊者，我们找个地方给白芷打个通讯吧。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_471_1"
                },
                {
                  "sequence": 24,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "我确认一下留言箱，九十九个未接来电……！？白芷、折枝、桃祈、姐姐、鉴心，还有今令尹……！？",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_471_2"
                },
                {
                  "sequence": 25,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "大家都很关心你啊。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_471_3"
                },
                {
                  "sequence": 26,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "哈哈……看来待会儿要打好多通讯了……",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_471_4"
                },
                {
                  "sequence": 27,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "那个，白芷——",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_472_29"
                },
                {
                  "sequence": 28,
                  "kind": "dialogue",
                  "speaker": "炽霞的声音",
                  "text": "白芷！你联系上秧秧他们了吗？太好了！秧秧、漂泊者，你们听得见我说话——",
                  "speaker_id": 350144,
                  "text_id": "Main_HuangLong_XLZHDLY_472_30"
                },
                {
                  "sequence": 29,
                  "kind": "dialogue",
                  "speaker": "折枝的声音",
                  "text": "炽炽炽炽霞！？你没事吧！？白芷小姐，炽霞从床上摔下去了！",
                  "speaker_id": 700041,
                  "text_id": "Main_HuangLong_XLZHDLY_472_26"
                },
                {
                  "sequence": 30,
                  "kind": "dialogue",
                  "speaker": "白芷（通讯中）",
                  "text": "……你伤还没完全好，这么激动干什么？",
                  "speaker_id": 1000,
                  "text_id": "Main_HuangLong_XLZHDLY_472_27"
                },
                {
                  "sequence": 31,
                  "kind": "dialogue",
                  "speaker": "炽霞的声音",
                  "text": "你还说我白芷！你不也——唔——",
                  "speaker_id": 350144,
                  "text_id": "Main_HuangLong_XLZHDLY_472_28"
                },
                {
                  "sequence": 32,
                  "kind": "dialogue",
                  "speaker": "白芷（通讯中）",
                  "text": "……好了，乖乖养伤。",
                  "speaker_id": 1000,
                  "text_id": "Main_HuangLong_XLZHDLY_472_31"
                },
                {
                  "sequence": 33,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "似乎很热闹的样子。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_472_49"
                },
                {
                  "sequence": 34,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "啊哈哈……",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_472_32"
                },
                {
                  "sequence": 35,
                  "kind": "dialogue",
                  "speaker": "白芷（通讯中）",
                  "text": "你们也听到了，不必担心炽霞，再过几天，她应该就又能活蹦乱跳了。",
                  "speaker_id": 1000,
                  "text_id": "Main_HuangLong_XLZHDLY_472_33"
                },
                {
                  "sequence": 36,
                  "kind": "dialogue",
                  "speaker": "白芷（通讯中）",
                  "text": "秧秧，漂泊者，虽然不知道你们这几天在玄方城经历了什么……",
                  "speaker_id": 1000,
                  "text_id": "Main_HuangLong_XLZHDLY_472_34"
                },
                {
                  "sequence": 37,
                  "kind": "dialogue",
                  "speaker": "白芷（通讯中）",
                  "text": "不过，看到你们平安无恙，就足够了。",
                  "speaker_id": 1000,
                  "text_id": "Main_HuangLong_XLZHDLY_472_35"
                },
                {
                  "sequence": 38,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "……对不起，我害大家担心了。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_472_36"
                },
                {
                  "sequence": 39,
                  "kind": "dialogue",
                  "speaker": "相里要（通讯中）",
                  "text": "不必自责，有一群为你担心的人，是件幸福的事。",
                  "speaker_id": 350153,
                  "text_id": "Main_HuangLong_XLZHDLY_472_37"
                },
                {
                  "sequence": 40,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "相里首席……！你也在啊。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_472_38"
                },
                {
                  "sequence": 41,
                  "kind": "dialogue",
                  "speaker": "相里要（通讯中）",
                  "text": "嗯，顺道路过而已。漂泊者，看来你已经成功找到秧秧了。不过……你们好像又同玄方城牵扯出了新的谜团？",
                  "speaker_id": 350153,
                  "text_id": "Main_HuangLong_XLZHDLY_472_39"
                },
                {
                  "sequence": 42,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "梦州的岁主心月狐，如今似乎下落不明。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_472_40"
                },
                {
                  "sequence": 43,
                  "kind": "dialogue",
                  "speaker": "相里要（通讯中）",
                  "text": "是吗……原谅我不能亲自到玄方城协助调查，不过，如果有需要的话，随时联系华胥研究院，这里的所有人都会倾力帮助你们。",
                  "speaker_id": 350153,
                  "text_id": "Main_HuangLong_XLZHDLY_472_41"
                },
                {
                  "sequence": 44,
                  "kind": "dialogue",
                  "speaker": "相里要（通讯中）",
                  "text": "时间差不多了，我该回研究室了。那么，祝你们早日完结这个课题。",
                  "speaker_id": 350153,
                  "text_id": "Main_HuangLong_XLZHDLY_472_42"
                },
                {
                  "sequence": 45,
                  "kind": "dialogue",
                  "speaker": "白芷（通讯中）",
                  "text": "秧秧，漂泊者，之后你们有什么打算？",
                  "speaker_id": 1000,
                  "text_id": "Main_HuangLong_XLZHDLY_472_43"
                },
                {
                  "sequence": 46,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "唔……",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_472_44"
                },
                {
                  "sequence": 47,
                  "kind": "dialogue",
                  "speaker": "白芷（通讯中）",
                  "text": "今州的情况，你们不必担心，先处理好手头的问题。",
                  "speaker_id": 1000,
                  "text_id": "Main_HuangLong_XLZHDLY_472_45"
                },
                {
                  "sequence": 48,
                  "kind": "dialogue",
                  "speaker": "白芷（通讯中）",
                  "text": "至于秧秧……等你什么时候有空，再向我和炽霞解释你这「新造型」是怎么一回事吧。最好等炽霞的伤全好之后，免得她因为大惊小怪又伤到筋骨。",
                  "speaker_id": 1000,
                  "text_id": "Main_HuangLong_XLZHDLY_472_46"
                },
                {
                  "sequence": 49,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "嗯，我知道了，白芷。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_472_48"
                },
                {
                  "sequence": 50,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "太好了，炽霞似乎没事。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_473_1"
                },
                {
                  "sequence": 51,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "等她见到你后，肯定会大吃一惊。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_473_2"
                },
                {
                  "sequence": 52,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "……可以的话，我倒是想变回原来的样子呢。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_473_3"
                },
                {
                  "sequence": 53,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "这也是你旅途的证明。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_473_4"
                },
                {
                  "sequence": 54,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "嗯……或许，是这样吧。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_473_5"
                },
                {
                  "sequence": 55,
                  "kind": "dialogue",
                  "speaker": "秋鸿（通讯中）",
                  "text": "漂泊者，秧秧，接下来有空的话，可否再来军策府一趟？",
                  "speaker_id": 350154,
                  "text_id": "Main_HuangLong_XLZHDLY_473_6"
                },
                {
                  "sequence": 56,
                  "kind": "dialogue",
                  "speaker": "秋鸿（通讯中）",
                  "text": "有一条找你们的通讯，对你们来说，应该是「熟面孔」了。",
                  "speaker_id": 350154,
                  "text_id": "Main_HuangLong_XLZHDLY_473_7"
                },
                {
                  "sequence": 57,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "（熟面孔……那大概是……）",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_473_8"
                },
                {
                  "sequence": 58,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "我想顺道去华胥研究院看望一下椋羽，如果漂泊者还有别的事，我们之后在军策府会合吧。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_473_9"
                },
                {
                  "sequence": 59,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "好，处理完手头的事后，就去卫长那里吧。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_473_10"
                },
                {
                  "sequence": 60,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "呵呵，看来水饺似乎喜欢上你啦。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_1"
                },
                {
                  "sequence": 61,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "你看上去兴致不错。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_474_2"
                },
                {
                  "sequence": 62,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "嗯~一般般吧，要是真正折腾起来的话，我有信心把玄方地界布置得跟梦州城一样热闹。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_3"
                },
                {
                  "sequence": 63,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "但这里的氛围我也很喜欢，少了点眼花缭乱，但多了很多真诚和友善。今州大概也是这种感觉吧？",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_4"
                },
                {
                  "sequence": 64,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "下次有机会，我和秧秧带你好好逛一趟今州。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_474_5"
                },
                {
                  "sequence": 65,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "哦？那你说的「下次」到底是什么时候呢？",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_6"
                },
                {
                  "sequence": 66,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "我可不像秧秧那样有耐心，如果你不定下一个具体的时间，我就默认能随时霸占你的行程咯？",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_7"
                },
                {
                  "sequence": 67,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "好啦，开个玩笑。至少也得等玄方地界的事告一段落吧。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_8"
                },
                {
                  "sequence": 68,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "说起来……为什么当时，你会说服心把信物交给我呢。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_474_9"
                },
                {
                  "sequence": 69,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "嗯……原因很多啦，今令尹也和我说了一些你的事，让我知道你有能使用岁主信物的能力。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_10"
                },
                {
                  "sequence": 70,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "你是想问，为什么我突然那么「信任」你吧？毕竟在那之前，我连跟心做了交易这件事都还瞒着你。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_11"
                },
                {
                  "sequence": 71,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "说复杂也复杂，说简单也简单……理由的话，有冠冕堂皇的版本，也有耍了点小心思的版本，你想听哪一个呢？",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_12"
                },
                {
                  "sequence": 72,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "我想听你的真心话。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_474_13"
                },
                {
                  "sequence": 73,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "……真直接啊，女孩子的心底话，可不是随随便便就能听到的哦？",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_14"
                },
                {
                  "sequence": 74,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "那么，真正的答案是，「我也不知道」。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_15"
                },
                {
                  "sequence": 75,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "……不知道？",
                  "text_id": "Main_HuangLong_XLZHDLY_474_16",
                  "choice_key": "剧情_3_5_后日谈梦州_6_1:15",
                  "selected_index": 0
                },
                {
                  "sequence": 76,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "该说你身上有一种很能让人依赖的感觉呢……还是举手投足间毫不做作呢……",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_17"
                },
                {
                  "sequence": 77,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "信赖这种东西，可以说是用漫长的时间构建起的一种联系，也可以说是一种直觉。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_19"
                },
                {
                  "sequence": 78,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "对你的话，大概是后者吧。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_20"
                },
                {
                  "sequence": 79,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "换句话说，就是女孩子的一片真心，怎么样？如果觉得太沉重的话，我收回去倒也无所谓啦。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_21"
                },
                {
                  "sequence": 80,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "……谢谢你能信任我。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_474_22"
                },
                {
                  "sequence": 81,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "……倒不用谢啦，不如说，我只是甩给了你一个大麻烦而已。",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_23"
                },
                {
                  "sequence": 82,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "不过，你说的约定，我可是真的记下咯？",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_24"
                },
                {
                  "sequence": 83,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "要写份合同吗？",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_474_25"
                },
                {
                  "sequence": 84,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "也不是不可以！还能再追加一些额外条款呢。比如，把你奉为我商会的座上宾，如何？",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_26"
                },
                {
                  "sequence": 85,
                  "kind": "dialogue",
                  "speaker": "穗穗",
                  "text": "至于这身份具体有什么用，等你来梦州城玩的时候，再揭晓咯？",
                  "speaker_id": 350099,
                  "text_id": "Main_HuangLong_XLZHDLY_474_27"
                },
                {
                  "sequence": 86,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "卫长，我们到了。您说的通讯是……",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_80"
                },
                {
                  "sequence": 87,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "不急，我现在就帮你们接通。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_480_20"
                },
                {
                  "sequence": 88,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "漂泊者，秧秧，太好了，你们都平安无事……",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_23"
                },
                {
                  "sequence": 89,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "我就猜到是你了。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_480_34"
                },
                {
                  "sequence": 90,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "呵呵，本来想等长离老师从明庭回来后再联络你们，但我还是有点等不及。",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_35"
                },
                {
                  "sequence": 91,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "我已经找秋鸿卫长了解了如今玄方城大致的情况，漂泊者，你是要留在玄方地界，寻找岁主心吧。",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_36"
                },
                {
                  "sequence": 92,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "那么，秧秧，你的意愿呢？",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_39"
                },
                {
                  "sequence": 93,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "我……是夜归的一员，现在案子已结，按照军规，我得回到今州……",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_40"
                },
                {
                  "sequence": 94,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "但是，今令尹，可否允许我和漂泊者一起，暂时留在玄方地界？我知道这不应当是军人该说出来的话——",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_42"
                },
                {
                  "sequence": 95,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "可现在玄方地界依旧动荡不安，这里还有很多人需要帮助。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_43"
                },
                {
                  "sequence": 96,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "虽然我只是一介踏白，但这里肯定还有我能做的事。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_44"
                },
                {
                  "sequence": 97,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "……秧秧，你不必如此看轻自己。现在的你所具备的力量，嗯……按照长离老师的话说，「肯定能在棋局上充当关键的一步」吧。",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_45"
                },
                {
                  "sequence": 98,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "你与玄方地界缔结的这份情谊，最后肯定会以某种形式，回馈到这片土地本身。",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_46"
                },
                {
                  "sequence": 99,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "所以，我尊重你的决定。秋鸿卫长，你意下如何？",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_47"
                },
                {
                  "sequence": 100,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "求之不得，现在地界中还有大量从咎庭出逃的残象流窜，正是急需战力的时刻。秧秧的能力更是能帮上不少忙。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_480_48"
                },
                {
                  "sequence": 101,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "秧秧，可否请你在这段时间，出任后玄骑使一职？我想，椋羽应该也很乐意听到这个消息。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_480_49"
                },
                {
                  "sequence": 102,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "……如果能帮到大家的话。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_50"
                },
                {
                  "sequence": 103,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "秧秧，我之后会同忌炎将军商议，将你暂时调至玄方地界的军策府麾下。",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_51"
                },
                {
                  "sequence": 104,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "漂泊者，可要代表我们今州人照顾好秧秧哦？",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_52"
                },
                {
                  "sequence": 105,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "我们互相照顾。",
                  "text_id": "Main_HuangLong_XLZHDLY_480_53",
                  "choice_key": "剧情_3_5_后日谈梦州_7_1:19",
                  "selected_index": 0
                },
                {
                  "sequence": 106,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "嗯，到时候，就把大家都聚在一起，开个庆功宴吧。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_55"
                },
                {
                  "sequence": 107,
                  "kind": "dialogue",
                  "speaker": "今汐（通讯中）",
                  "text": "好主意，那么，我在今州等你们回家。",
                  "speaker_id": 1212,
                  "text_id": "Main_HuangLong_XLZHDLY_480_56"
                },
                {
                  "sequence": 108,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "啊，是你呀……",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_59"
                },
                {
                  "sequence": 109,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "它一路上帮了不少忙呢。",
                  "speaker_id": 750088,
                  "text_id": "Main_HuangLong_XLZHDLY_480_60"
                },
                {
                  "sequence": 110,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "这只梁鸢……我此前从未见过……",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_480_61"
                },
                {
                  "sequence": 111,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "你好像对梁鸢很有研究？",
                  "text_id": "Main_HuangLong_XLZHDLY_480_62",
                  "choice_key": "剧情_3_5_后日谈梦州_7_1:24",
                  "selected_index": 0
                },
                {
                  "sequence": 112,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "梁鸢……最初是玄方地界的工匠们为纪念玄翎雀而造，然而传承至今，其中衍生繁多，有的形象甚至也已与玄翎雀大相径庭。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_480_64"
                },
                {
                  "sequence": 113,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "但这只梁鸢……以我多年的眼力，至少是两百年前的作品了。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_480_65"
                },
                {
                  "sequence": 114,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "制作它的工匠，肯定曾见过真正的玄翎雀飞翔于天际的模样。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_480_66"
                },
                {
                  "sequence": 115,
                  "kind": "dialogue",
                  "speaker": "秋鸿",
                  "text": "我能从它身上，感受到一股深深的……怀念之情。",
                  "speaker_id": 350151,
                  "text_id": "Main_HuangLong_XLZHDLY_480_67"
                },
                {
                  "sequence": 116,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "这点卫长您也不差多少了……",
                  "text_id": "Main_HuangLong_XLZHDLY_480_68",
                  "choice_key": "剧情_3_5_后日谈梦州_7_1:28",
                  "selected_index": 0
                },
                {
                  "sequence": 117,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "也可能，它不单只是一只梁鸢呢……",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_70"
                },
                {
                  "sequence": 118,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "不管怎样，谢谢你……你的愿望，现在就在我的心里。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_71"
                },
                {
                  "sequence": 119,
                  "kind": "dialogue",
                  "speaker": "秧秧",
                  "text": "飞吧，飞到你想去的任何地方。",
                  "speaker_id": 108,
                  "text_id": "Main_HuangLong_XLZHDLY_480_73"
                },
                {
                  "sequence": 120,
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "有劳了，吾友。",
                  "speaker_id": 178,
                  "text_id": "Main_HuangLong_XLZHDLY_480_76"
                },
                {
                  "sequence": 121,
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "……是吗，如此丰沛的情感与意志，于你我而言也是久违了。",
                  "speaker_id": 178,
                  "text_id": "Main_HuangLong_XLZHDLY_480_77"
                },
                {
                  "sequence": 122,
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "若你觉得，他们是值得托付之人……",
                  "speaker_id": 178,
                  "text_id": "Main_HuangLong_XLZHDLY_480_78"
                },
                {
                  "sequence": 123,
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "便让这灯火，再亮一些时日吧。",
                  "speaker_id": 178,
                  "text_id": "Main_HuangLong_XLZHDLY_480_79"
                }
              ]
            }
          ],
          "source_chapter": "梦州 第四章",
          "source_act_id": 41
        }
      ]
    }
  ]
}
