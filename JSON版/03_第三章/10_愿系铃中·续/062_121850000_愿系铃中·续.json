  "chapters": [
    {
      "number": 3,
      "title": "第三章",
      "sections": [
        {
          "number": 10,
          "title": "愿系铃中·续",
          "act": "幕间",
          "notes": [],
          "tasks": [
            {
              "sequence": 62,
              "quest_id": 121850000,
              "title": "愿系铃中·续",
              "reading_status": "ordered_draft",
              "notes": [],
              "events": [
                {
                  "sequence": 1,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "（玉露姐，应当就在前面了……）",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_189_1"
                },
                {
                  "sequence": 2,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "（这是，在穗波最后的祓净仪式。）",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_189_2"
                },
                {
                  "sequence": 3,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "（一切都已尘埃落定，只剩这一件事要做。）",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_190_1"
                },
                {
                  "sequence": 4,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "（真是……让你等了很久啊，玉露姐。）",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_191_1"
                },
                {
                  "sequence": 5,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "终于肯来了？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_21080_1"
                },
                {
                  "sequence": 6,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "嗯，我来了。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_21080_2"
                },
                {
                  "sequence": 7,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "想好了？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_21080_3"
                },
                {
                  "sequence": 8,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "想好了。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_21080_4"
                },
                {
                  "sequence": 9,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "能下手杀我了？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_21080_5"
                },
                {
                  "sequence": 10,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "……嗯。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_21080_6"
                },
                {
                  "sequence": 11,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "哦？我们家绯雪已经这么有自信，觉得无需挥刀，就能轻易超度我了？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_21080_7"
                },
                {
                  "sequence": 12,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "再怎么说，我也是教导出「永世灼樱巫女」的前辈，怎么也该尊重一下吧？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_21080_8"
                },
                {
                  "sequence": 13,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "玉露姐过去对我做过的事，也能算作教导吗？",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_21080_9"
                },
                {
                  "sequence": 14,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "来吧，永世灼樱巫女大人。",
                  "text_id": "Zuoyequnxing_192_10"
                },
                {
                  "sequence": 15,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "……",
                  "text_id": "Zuoyequnxing_192_11"
                },
                {
                  "sequence": 16,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "静心",
                  "text_id": "Zuoyequnxing_192_12"
                },
                {
                  "sequence": 17,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "心不静，手不稳",
                  "text_id": "Zuoyequnxing_192_13"
                },
                {
                  "sequence": 18,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "我……不想学这个",
                  "text_id": "Zuoyequnxing_192_14"
                },
                {
                  "sequence": 19,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "那，你想学什么？",
                  "text_id": "Zuoyequnxing_192_15"
                },
                {
                  "sequence": 20,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "这孩子一定能成为有名的箭手",
                  "text_id": "Zuoyequnxing_192_16"
                },
                {
                  "sequence": 21,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "可不对，她的手是握刀的手",
                  "text_id": "Zuoyequnxing_192_17"
                },
                {
                  "sequence": 22,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "下辈子吧",
                  "text_id": "Zuoyequnxing_192_18"
                },
                {
                  "sequence": 23,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "她的手不是该握刀的手，对不对？",
                  "text_id": "Zuoyequnxing_192_19"
                },
                {
                  "sequence": 24,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "这招不错，长进不少啊？",
                  "text_id": "Zuoyequnxing_192_20"
                },
                {
                  "sequence": 25,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "哼",
                  "text_id": "Zuoyequnxing_192_21"
                },
                {
                  "sequence": 26,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "绯雪呀……",
                  "text_id": "Zuoyequnxing_192_22"
                },
                {
                  "sequence": 27,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "不必囿于那铃中的宿命",
                  "text_id": "Zuoyequnxing_192_23"
                },
                {
                  "sequence": 28,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "你当去往你自己的未来",
                  "text_id": "Zuoyequnxing_192_24"
                },
                {
                  "sequence": 29,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "来了，绯雪",
                  "text_id": "Zuoyequnxing_192_25"
                },
                {
                  "sequence": 30,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "若你能过了这一刀",
                  "text_id": "Zuoyequnxing_192_26"
                },
                {
                  "sequence": 31,
                  "kind": "subtitle",
                  "speaker": null,
                  "display_label": "字幕",
                  "text": "才有明天",
                  "text_id": "Zuoyequnxing_192_27"
                },
                {
                  "sequence": 32,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "啧啧，你从其他人那儿承来百般武艺，怎么灼樱本家用刀的手法这么粗糙。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_1"
                },
                {
                  "sequence": 33,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "上任巫女藏得太多，一招都不肯教。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_2"
                },
                {
                  "sequence": 34,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "你怨她吗？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_3"
                },
                {
                  "sequence": 35,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "怨。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_4"
                },
                {
                  "sequence": 36,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "现在也怨她吗？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_5"
                },
                {
                  "sequence": 37,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "每时每刻。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_6"
                },
                {
                  "sequence": 38,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "我怨她早该从灼樱巫女的位置上退下来，为什么偏要把自己的未来预取殆尽，连死后的余灰都不肯留。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_7"
                },
                {
                  "sequence": 39,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "我怨她没把所有技艺都仔细传给我，每次挥刀时偏要把我支开，事到如今，从我身上看不到一点她的影子。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_8"
                },
                {
                  "sequence": 40,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "绯雪……",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_9"
                },
                {
                  "sequence": 41,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "我怨她口口声声念着要绯雪去做绯雪，她自己却选了最不像自己的死法。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_10"
                },
                {
                  "sequence": 42,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "你怨她死后还偏要作亡魂滞留，只等着你亲手来送她去往世。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_11"
                },
                {
                  "sequence": 43,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "哎呀。实在有些太坏心了。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_12"
                },
                {
                  "sequence": 44,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "只是，我实在放心不下……没人比我更清楚小绯雪的天赋，你甚至有着能驾驭鸣式的可能性。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_13"
                },
                {
                  "sequence": 45,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "如果干脆取用那样的未来，一切都会变得很轻松吧？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_14"
                },
                {
                  "sequence": 46,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "姐姐，我……",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_15"
                },
                {
                  "sequence": 47,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "只要是出于你的本心，只要你是凭借自己的意志做出的决断，不论你选择哪一条未来，都可以。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_16"
                },
                {
                  "sequence": 48,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "不过，要是我们小绯雪真的去当了什么鸣式共鸣者，那我就只能动用“家法”，把我们俩一起送走咯。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_17"
                },
                {
                  "sequence": 49,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "那份未来，已被我预取尽了。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_18"
                },
                {
                  "sequence": 50,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "我是凭借自己的意志接过了「铃」，选择成为灼樱巫女的。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_19"
                },
                {
                  "sequence": 51,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "我知道，你一直不肯教我刀术，是不希望再有下一任巫女。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_20"
                },
                {
                  "sequence": 52,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "你的愿望就由我来实现，玉露姐姐。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_21"
                },
                {
                  "sequence": 53,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "自绯雪以后，不会再有下一任灼樱巫女。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_22"
                },
                {
                  "sequence": 54,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "「永世灼樱巫女」吗……会很辛苦哦？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_23"
                },
                {
                  "sequence": 55,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "嗯。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_24"
                },
                {
                  "sequence": 56,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "未来还会有很漫长很漫长的时间哦？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_25"
                },
                {
                  "sequence": 57,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "嗯，我知道。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_26"
                },
                {
                  "sequence": 58,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "我们能够通过那「铃」，预取未来的可能性中蕴藏的力量。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_27"
                },
                {
                  "sequence": 59,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "但随着你对「铃」的使用，只能眼看着自己一步一步走向灼樱巫女既定的结局，竭尽未来而死，连死后的余灰都留不下哦？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_28"
                },
                {
                  "sequence": 60,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "嗯，在那既定的终点到来前，我一定会想办法击退鸣式。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_29"
                },
                {
                  "sequence": 61,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "让玉露只需要成为玉露，让绯雪只需要成为绯雪，让苇原不再需要灼樱巫女。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_30"
                },
                {
                  "sequence": 62,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "长大了啊，我们小绯雪。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_31"
                },
                {
                  "sequence": 63,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "……",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_32"
                },
                {
                  "sequence": 64,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "玉露姐姐，近来，我遇到了一个人。与我在苇原的路不同，她总是能成功“拯救”。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_33"
                },
                {
                  "sequence": 65,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "这对小绯雪而言，有些难以忍受吧。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_34"
                },
                {
                  "sequence": 66,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "嗯。初时……是这样的。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_35"
                },
                {
                  "sequence": 67,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "听闻那个人的事时，我对她深感羡慕。不，或许可说是嫉妒吧。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_36"
                },
                {
                  "sequence": 68,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "我想，若我也能如她一般强大，就不会只得到遗憾和悔恨。苇原，亦能得救。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_37"
                },
                {
                  "sequence": 69,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "而我……也能在一切结束后，如常人般平凡地活下去。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_38"
                },
                {
                  "sequence": 70,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "但后来与之接触，我才明白那个人身为成功的“救世主”，也有许多痛苦和失败。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_39"
                },
                {
                  "sequence": 71,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "而在“拯救”之路前行，也仰赖路上无数同行之人。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_40"
                },
                {
                  "sequence": 72,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "玉露姐。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_41"
                },
                {
                  "sequence": 73,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "嗯？",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_42"
                },
                {
                  "sequence": 74,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "我一直仰慕着你身为灼樱巫女的身姿，也一直……以你为傲。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_43"
                },
                {
                  "sequence": 75,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "即便有朝一日我自身烧却成灰……",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_44"
                },
                {
                  "sequence": 76,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "因你曾存在过……因她……他们存在着……我也并不孤独。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_193_45"
                },
                {
                  "sequence": 77,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "我也以你为傲。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_46"
                },
                {
                  "sequence": 78,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "去吧白鸟，去你想去的地方吧。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_47"
                },
                {
                  "sequence": 79,
                  "kind": "dialogue",
                  "speaker": "玉露",
                  "text": "愿你有朝一日，也能如世间任一常人般，步入春日。",
                  "speaker_id": 250086,
                  "text_id": "Zuoyequnxing_193_48"
                },
                {
                  "sequence": 80,
                  "kind": "dialogue",
                  "speaker": "残星会会长（通讯中）",
                  "text": "你好呀，灼樱巫女。",
                  "speaker_id": 850632,
                  "text_id": "Zuoyequnxing_194_1"
                },
                {
                  "sequence": 81,
                  "kind": "dialogue",
                  "speaker": "绯雪",
                  "text": "……是你。",
                  "speaker_id": 200138,
                  "text_id": "Zuoyequnxing_194_2"
                },
                {
                  "sequence": 82,
                  "kind": "dialogue",
                  "speaker": "残星会会长（通讯中）",
                  "text": "别担心，我不是来劝你加入残星会的。只是听到了一个消息，觉得你或许会感兴趣。",
                  "speaker_id": 850632,
                  "text_id": "Zuoyequnxing_194_3"
                },
                {
                  "sequence": 83,
                  "kind": "dialogue",
                  "speaker": "残星会会长（通讯中）",
                  "text": "就在不久之前，那座浮在海上的岛屿，你的故乡——",
                  "speaker_id": 850632,
                  "text_id": "Zuoyequnxing_194_4"
                },
                {
                  "sequence": 84,
                  "kind": "dialogue",
                  "speaker": "残星会会长（通讯中）",
                  "text": "在一日之内，凭空消失无踪了。",
                  "speaker_id": 850632,
                  "text_id": "Zuoyequnxing_194_5"
                },
                {
                  "sequence": 85,
                  "kind": "dialogue",
                  "speaker": "残星会会长（通讯中）",
                  "text": "那么，恭喜你愿望成真，灼樱巫女。",
                  "speaker_id": 850632,
                  "text_id": "Zuoyequnxing_194_6"
                }
              ]
            }
          ],
          "source_chapter": "拉海洛 第三章",
          "source_act_id": 36
        }
      ]
    }
  ]
}
