  "chapters": [
    {
      "number": 2,
      "title": "第二章",
      "sections": [
        {
          "number": 8,
          "title": "捕梦于神秘园中",
          "act": "第七幕",
          "notes": [],
          "tasks": [
            {
              "sequence": 34,
              "quest_id": 172000003,
              "title": "捕梦于神秘园中",
              "reading_status": "ordered_draft",
              "notes": [],
              "events": [
                {
                  "sequence": 1,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "下面这么复杂，我们怎么找曲谱？",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_78_1"
                },
                {
                  "sequence": 2,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "既然有人刻意隐藏，不妨从他的角度思考。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_78_2"
                },
                {
                  "sequence": 3,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "从这里下去，不会有意外。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_76_1"
                },
                {
                  "sequence": 4,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "你……",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_77_1"
                },
                {
                  "sequence": 5,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "……我也没想到。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_77_2"
                },
                {
                  "sequence": 6,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "这里竟然有声骸培育舱……保持警惕，或许声骸会从中脱出，攻击我们。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_79_1"
                },
                {
                  "sequence": 7,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "不会，它们还年幼。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_79_2"
                },
                {
                  "sequence": 8,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "……",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_80_1"
                },
                {
                  "sequence": 9,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "你还是先别说话了。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_80_2"
                },
                {
                  "sequence": 10,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "我们各走一边。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_1"
                },
                {
                  "sequence": 11,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "你想单独行动？",
                  "text_id": "Main_Linaxita_2_7_81_2",
                  "choice_key": "剧情_2_5_隐底试验场_能源场下层_1_6:1",
                  "selected_index": 0
                },
                {
                  "sequence": 12,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "芬莱克有可能将两段曲谱分开存放来拖住我们。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_3"
                },
                {
                  "sequence": 13,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "你在怀疑，这一切都是我们将你算计其中的一环。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_4"
                },
                {
                  "sequence": 14,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "毕竟我无法确认彼岸的状况。",
                  "text_id": "Main_Linaxita_2_7_81_5",
                  "choice_key": "剧情_2_5_隐底试验场_能源场下层_1_6:3",
                  "selected_index": 0
                },
                {
                  "sequence": 15,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "呵……你的反应让我更加确定，芬莱克一定会将我们分开，并将两段曲谱分开藏放。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_7"
                },
                {
                  "sequence": 16,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "一个聪明人，怎么会轻易放过这个机会，不去编织一个我们注定会踏入的罗网。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_8"
                },
                {
                  "sequence": 17,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "一起兜兜转转过于消耗时间，可一旦分离，敌人之间一触即碎的脆弱联结将可能不复存在……",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_9"
                },
                {
                  "sequence": 18,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "怀疑、争辩、踟蹰不前……环绕在我们身侧，想要把我们赶下坟墓里去——而这正是他愿意看到的。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_10"
                },
                {
                  "sequence": 19,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "我不会让他如愿，你呢？",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_11"
                },
                {
                  "sequence": 20,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "什么意思？",
                  "text_id": "Main_Linaxita_2_7_81_12",
                  "choice_key": "剧情_2_5_隐底试验场_能源场下层_1_6:8",
                  "selected_index": 0
                },
                {
                  "sequence": 21,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "它蕴含着我的能力，与我紧密相连，是受伤之后我唯一的依靠。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_13"
                },
                {
                  "sequence": 22,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "我将它交予你，即便你我相距遥远，它与我仍将在你指掌之间。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_14"
                },
                {
                  "sequence": 23,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "你居然愿意做到这一步。",
                  "text_id": "Main_Linaxita_2_7_81_15",
                  "choice_key": "剧情_2_5_隐底试验场_能源场下层_1_6:10",
                  "selected_index": 0
                },
                {
                  "sequence": 24,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "停滞不前只会让你我都得不到自己想要的结果。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_16"
                },
                {
                  "sequence": 25,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "记得早点过来。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_81_17"
                },
                {
                  "sequence": 26,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "早已设好的埋伏？",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_82_1"
                },
                {
                  "sequence": 27,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "呵，久等了。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_82_2"
                },
                {
                  "sequence": 28,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "多此一举。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_83_1"
                },
                {
                  "sequence": 29,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "这里的装置和前面见到的应该是一样的。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_178_1"
                },
                {
                  "sequence": 30,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "应该能调整水位，从上面的出口出去。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_178_2"
                },
                {
                  "sequence": 31,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "失去了向导还是有点麻烦……",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_84_2"
                },
                {
                  "sequence": 32,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "有我在的话，就不麻烦啦。",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_84_3"
                },
                {
                  "sequence": 33,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "睡醒了？",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_84_4"
                },
                {
                  "sequence": 34,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "嗯嗯，精神抖擞！",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_84_5"
                },
                {
                  "sequence": 35,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "不过，这是什么地方？看起来弯弯绕绕的，好晕啊……",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_84_6"
                },
                {
                  "sequence": 36,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "我们一起想想办法。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_84_8"
                },
                {
                  "sequence": 37,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "没问题！",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_84_9"
                },
                {
                  "sequence": 38,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "哼，也没那么难嘛，这不就走出来了。",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_85_1"
                },
                {
                  "sequence": 39,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "再不出来你都要晕倒了。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_85_2"
                },
                {
                  "sequence": 40,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "哪有，我怎么可能会被这种小困难打败。",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_85_3"
                },
                {
                  "sequence": 41,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "走吧，还要去找乐谱。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_179_1"
                },
                {
                  "sequence": 42,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "什么乐谱？",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_179_2"
                },
                {
                  "sequence": 43,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "解释起来有点复杂……",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_179_3"
                },
                {
                  "sequence": 44,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "没关系，我帮你一起找，其他的事你记得之后讲给我听！",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_179_4"
                },
                {
                  "sequence": 45,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "她应该可以安全过去了，我们走吧。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_93_1"
                },
                {
                  "sequence": 46,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "这里有好多资料！要不要找找看，说不定能找到那个什么乐谱呢。",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_86_1"
                },
                {
                  "sequence": 47,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "“人工索诺拉持续时间短，难以保持稳定状态，且共鸣者的力量容易使索诺拉产生意外变化。”",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_89_1"
                },
                {
                  "sequence": 48,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "“如果要创造庞大、稳定的索诺拉，将它变为能承载所有人的现实世界，耗资巨大且需要消耗我的共鸣能力。”",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_89_2"
                },
                {
                  "sequence": 49,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "“这个研究方向已获得稳定支持，可以继续推进。记录人……弗洛洛。”",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_89_3"
                },
                {
                  "sequence": 50,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "这些资料都是有关海蚀现象的。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_89_4"
                },
                {
                  "sequence": 51,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "弗洛洛干嘛要研究这些？",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_89_5"
                },
                {
                  "sequence": 52,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "这些研究的共性似乎是……寻找承载人们意识的另一种可能。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_89_6"
                },
                {
                  "sequence": 53,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "如果芬莱克的录音没有作假，那么弗洛洛创造失亡彼岸又是为了承载谁的意识？",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_89_7"
                },
                {
                  "sequence": 54,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "“溯洄雨的频率是更加纯净、稳定的回音能量。这次或许有希望。”",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_88_1"
                },
                {
                  "sequence": 55,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "“不行，雨中留存的人类意识过于薄弱，仅有内容重复的残影短暂停留。”",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_88_2"
                },
                {
                  "sequence": 56,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "“溯洄雨出现时机不稳定，且无法单独形成残象或声骸实体进行人类意识大量留存，研究终止。记录人……弗洛洛。”",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_88_3"
                },
                {
                  "sequence": 57,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "“黑潮生成的残象由更破碎、融合更严重的频率组合而成。”",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_87_1"
                },
                {
                  "sequence": 58,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "“它们没有个体意识，融合中的整体意识完全由利维亚坦整合、塑造。”",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_87_2"
                },
                {
                  "sequence": 59,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "“黑潮无法承托、保存人们原有的意识，研究终止。记录人……弗洛洛。”",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_87_3"
                },
                {
                  "sequence": 60,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "这些家伙是不是在守卫什么？",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_95_1"
                },
                {
                  "sequence": 61,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "我们离乐谱不远了。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_95_2"
                },
                {
                  "sequence": 62,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "欸，那是弗洛洛？",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_94_1"
                },
                {
                  "sequence": 63,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "她在和谁说话吗……看不清……",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_94_2"
                },
                {
                  "sequence": 64,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "算了，还是先继续往前走吧。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_94_3"
                },
                {
                  "sequence": 65,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "是乐谱，找到了。我们尽快拿回去吧。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_96_1"
                },
                {
                  "sequence": 66,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "回去？回哪？",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_96_2"
                },
                {
                  "sequence": 67,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "和弗洛洛会合。",
                  "text_id": "Main_Linaxita_2_7_96_3",
                  "choice_key": "剧情_2_5_隐底试验场_能源场下层_2_1:2",
                  "selected_index": 0
                },
                {
                  "sequence": 68,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "虽然不知道你们是怎么回事……不过，你还是自己去吧。",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_96_4"
                },
                {
                  "sequence": 69,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "怎么？",
                  "text_id": "Main_Linaxita_2_7_96_5",
                  "choice_key": "剧情_2_5_隐底试验场_能源场下层_2_1:3",
                  "selected_index": 0
                },
                {
                  "sequence": 70,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "她的频率……有点奇怪。",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_96_6"
                },
                {
                  "sequence": 71,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "奇怪？",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_96_7"
                },
                {
                  "sequence": 72,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "帮我留意周围，以防意外发生。不过这里现在很混乱，还可能有鸣式在旁干扰，你还是先回来比较安全。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_96_8"
                },
                {
                  "sequence": 73,
                  "kind": "dialogue",
                  "speaker": "阿布",
                  "text": "好，那你一个人可要小心哦。",
                  "speaker_id": 1316,
                  "text_id": "Main_Linaxita_2_7_96_9"
                },
                {
                  "sequence": 74,
                  "kind": "dialogue",
                  "speaker": "旁白",
                  "text": "二人分别后的另一边。",
                  "text_id": "Main_Linaxita_2_7_97_1"
                },
                {
                  "sequence": 75,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "（没想到……你会出手。）",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_98_1"
                },
                {
                  "sequence": 76,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "（守卫变多了……还有“眼睛”……）",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_99_1"
                },
                {
                  "sequence": 77,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "（绕路吧。）",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_99_2"
                },
                {
                  "sequence": 78,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "（呵……密集的监视何尝不是畏惧的表现。）",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_102_1"
                },
                {
                  "sequence": 79,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "（那边可以出去。）",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_101_1"
                },
                {
                  "sequence": 80,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "（乐歌响起之时，这些人或许会被旋律吸引，忽视一闪而过的变数。）",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_101_2"
                },
                {
                  "sequence": 81,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "（嗯……告诉我，你要如何才能奏响乐曲呢。）",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_101_3"
                },
                {
                  "sequence": 82,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "（各位，准备好沉浸于乐曲之中了吗？）",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_103_1"
                },
                {
                  "sequence": 83,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "（看来需要等一个不被注视的时机。）",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_100_1"
                },
                {
                  "sequence": 84,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "弗洛洛姐姐，你好像遇到了瓶颈？",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_1"
                },
                {
                  "sequence": 85,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "不要以她的容貌出现在我面前，会长。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_104_2"
                },
                {
                  "sequence": 86,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "可是，以前你都会对这样的“我”感到亲切啊。",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_3"
                },
                {
                  "sequence": 87,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "你怎么会来这里？",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_104_4"
                },
                {
                  "sequence": 88,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "“我”答应过你的，让你心中那首彼岸的哀歌在这里唱响，让“我们”重新在这里获得新生。",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_5"
                },
                {
                  "sequence": 89,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "那只眼睛里积攒的频率让你不堪重负，成百上千人的呼喊与求救每时每刻都在你的脑海中回响……",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_6"
                },
                {
                  "sequence": 90,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "“我”知道你能撑住，几百年来你都是这么做的。半残象化的躯体不死不生，不会被任何事物打败，可“我”不想让你的精神受此折磨。",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_7"
                },
                {
                  "sequence": 91,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "但是……局势有变，七丘的事情发生后，奥古斯塔已经有所行动……",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_8"
                },
                {
                  "sequence": 92,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "“不以命运的喜怒为意，在祂没有堕地以前把祂摄取，凭着祂呼灵唤鬼”，这是你给我的许诺。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_104_9"
                },
                {
                  "sequence": 93,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "失去利维亚坦融合的力量，我无法让所有人在彼岸中重生。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_104_10"
                },
                {
                  "sequence": 94,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "你当然还可以做这些啦！你是在救“我们”！",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_11"
                },
                {
                  "sequence": 95,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "“我”只是想让你帮助克里斯托弗完成他的计划后，再来实现这一切而已。",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_12"
                },
                {
                  "sequence": 96,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "你瞧，海底已经陷入了意外的混乱，在这个时候紧迫地将“我们”唤回或许并不是最好的时机。",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_13"
                },
                {
                  "sequence": 97,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "将残响频率融合到残象中，让“我们”重新拥有实体的同时保存住原本的意识……你一定想要更稳定、长久的时间去仔细把“我们”复原得更加完美吧？",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_14"
                },
                {
                  "sequence": 98,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "就算我先帮你们，漂泊者也一定会拼尽全力阻止。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_104_15"
                },
                {
                  "sequence": 99,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "彼岸正在向你融合，当你有能力打开那扇门扉，你就可以尝试将她永远地留在“我们”这里。",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_16"
                },
                {
                  "sequence": 100,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "……",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_104_17"
                },
                {
                  "sequence": 101,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "哦？你犹豫了，你们之间那短暂的回忆会比“我们”还重要吗？",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_18"
                },
                {
                  "sequence": 102,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "不，彼岸中本就有属于她的席位，提前实现这件事也没什么。她终将在那里，还我一个承诺。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_104_19"
                },
                {
                  "sequence": 103,
                  "kind": "dialogue",
                  "speaker": "“特莉丝”",
                  "text": "呵呵呵……加快脚步吧，彼岸对你的影响还在加深，你的时间不多咯。",
                  "speaker_id": 300023,
                  "text_id": "Main_Linaxita_2_7_104_20"
                },
                {
                  "sequence": 104,
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "弗洛洛，等这首乐曲真正完成时，我一定会再来。",
                  "speaker_id": 178,
                  "text_id": "Main_Linaxita_2_7_106_1"
                },
                {
                  "sequence": 105,
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "真的？",
                  "speaker_id": 178,
                  "text_id": "Main_Linaxita_2_7_106_2"
                },
                {
                  "sequence": 106,
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "真的，无论在哪。",
                  "speaker_id": 178,
                  "text_id": "Main_Linaxita_2_7_106_3"
                },
                {
                  "sequence": 107,
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "任何一个承诺都很重要，只要许诺了我就一定会实现。",
                  "speaker_id": 178,
                  "text_id": "Main_Linaxita_2_7_106_4"
                },
                {
                  "sequence": 108,
                  "kind": "dialogue",
                  "speaker": "热情的邻居",
                  "text": "弗洛洛，说好明天要一起去隔壁城里玩的，别忘了！",
                  "speaker_id": 300030,
                  "text_id": "Main_Linaxita_2_7_106_5"
                },
                {
                  "sequence": 109,
                  "kind": "dialogue",
                  "speaker": "好奇的听众",
                  "text": "弗洛洛，您指挥的乐曲背后究竟有什么样的故事？",
                  "speaker_id": 300026,
                  "text_id": "Main_Linaxita_2_7_106_6"
                },
                {
                  "sequence": 110,
                  "kind": "dialogue",
                  "speaker": "亲近的朋友",
                  "text": "弗洛洛，我们说好啦，要做一辈子的朋友，谁也不能先离开谁。",
                  "speaker_id": 300032,
                  "text_id": "Main_Linaxita_2_7_106_7"
                },
                {
                  "sequence": 111,
                  "kind": "dialogue",
                  "speaker": "悲观的学者",
                  "text": "弗洛洛，人死后的残响终究会逸散或扭曲。变成残象的话，它们就不是人了。",
                  "speaker_id": 300033,
                  "text_id": "Main_Linaxita_2_7_106_8"
                },
                {
                  "sequence": 112,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "那个时代做不到的，我马上可以做到了……",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_106_9"
                },
                {
                  "sequence": 113,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "你们的骨髓将不再枯竭，你们的血液将不再凝冷……",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_106_10"
                },
                {
                  "sequence": 114,
                  "kind": "dialogue",
                  "speaker": "痛苦的家人",
                  "text": "弗洛洛，活下去……我们多么想和你一起活下去……",
                  "speaker_id": 300034,
                  "text_id": "Main_Linaxita_2_7_106_11"
                },
                {
                  "sequence": 115,
                  "kind": "dialogue",
                  "speaker": "释怀的恩师",
                  "text": "弗洛洛，我相信你指挥出的旋律，终有一天会改变这个世界的……",
                  "speaker_id": 300035,
                  "text_id": "Main_Linaxita_2_7_106_12"
                },
                {
                  "sequence": 116,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "我可以……",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_106_13"
                },
                {
                  "sequence": 117,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "世间皆是共通的频率，人可以是残象，残象可以是人……它们只是不同的躯壳，它们之间没有那条界限。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_106_14"
                },
                {
                  "sequence": 118,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "我没有那条线，所有人都可以没有那条线。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_106_15"
                },
                {
                  "sequence": 119,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "你刚才碰到了什么，怎么会引发爆炸？",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_108_3"
                },
                {
                  "sequence": 120,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "芬莱克把能源安全系统和曲谱绑在了一起。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_108_4"
                },
                {
                  "sequence": 121,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "呵，不惜影响这里的频率能量，他真是在我们身上耗费颇多啊。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_108_5"
                },
                {
                  "sequence": 122,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "希望他喜欢我们送他的这首歌。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_108_6"
                },
                {
                  "sequence": 123,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "之前说好的。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_109_1"
                },
                {
                  "sequence": 124,
                  "kind": "dialogue",
                  "speaker": "无署名",
                  "text": "你将弗洛洛的彼岸花指挥棒交还给了她。",
                  "speaker_id": 83,
                  "text_id": "Main_Linaxita_2_7_109_2"
                },
                {
                  "sequence": 125,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "现在的你还能进行调律吗？",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_109_3"
                },
                {
                  "sequence": 126,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "当然。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_109_4"
                },
                {
                  "sequence": 127,
                  "kind": "dialogue",
                  "speaker": "无署名",
                  "text": "弗洛洛思考后，将手里的所有曲谱交给了你。",
                  "speaker_id": 83,
                  "text_id": "Main_Linaxita_2_7_109_5"
                },
                {
                  "sequence": 128,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "剩下的部分由你完成。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_109_6"
                },
                {
                  "sequence": 129,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "为什么？",
                  "text_id": "Main_Linaxita_2_7_109_7",
                  "choice_key": "剧情_2_5_隐底试验场_能源场下层_3_1:6",
                  "selected_index": 0
                },
                {
                  "sequence": 130,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "“这里的变化是否真的源自旋律的改变？”",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_109_8"
                },
                {
                  "sequence": 131,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "“乐谱中是否还隐藏着其他不为人知的计划？”",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_109_9"
                },
                {
                  "sequence": 132,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "无论怎样想过……",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_109_10"
                },
                {
                  "sequence": 133,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "只有亲自掌握才能真正相信这里的一切。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_109_11"
                },
                {
                  "sequence": 134,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "我们才能走得更远。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_109_12"
                },
                {
                  "sequence": 135,
                  "kind": "choice",
                  "speaker": "漂泊者",
                  "text": "好，这次就由我来完成调律。",
                  "text_id": "Main_Linaxita_2_7_109_13",
                  "choice_key": "剧情_2_5_隐底试验场_能源场下层_3_1:11",
                  "selected_index": 0
                },
                {
                  "sequence": 136,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "这一次落地应该就能到达宝石所在了？",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_111_1"
                },
                {
                  "sequence": 137,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "嗯。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_111_2"
                },
                {
                  "sequence": 138,
                  "kind": "dialogue",
                  "speaker": "漂泊者",
                  "text": "按照之前修会追兵所说，芬莱克应该带人正守在那里。",
                  "speaker_id": 750088,
                  "text_id": "Main_Linaxita_2_7_111_3"
                },
                {
                  "sequence": 139,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "再不可思议的故事也总该迎来结局，我们也总归要出手。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_111_4"
                },
                {
                  "sequence": 140,
                  "kind": "dialogue",
                  "speaker": "弗洛洛",
                  "text": "到时候，也是你可以对我动手的时候了。",
                  "speaker_id": 560,
                  "text_id": "Main_Linaxita_2_7_111_5"
                }
              ]
            }
          ],
          "source_chapter": "黎那汐塔 第二章",
          "source_act_id": 18
        }
      ]
    }
  ]
}
